# AI LearnMate Environment Configuration Example
# Copy this file to .env and insert your configuration:
# copy .env.example .env

# Flask Secret Key for session security (change in production)
SECRET_KEY=learnmate-hackathon-super-secret-key-change-in-prod

# SQLite Database File Path
DATABASE_PATH=learnmate.db

# Preferred AI Provider: 'gemini' or 'openai' or 'demo'
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended for live AI question generation)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if using OpenAI provider)
OPENAI_API_KEY=

# Maximum upload file size in bytes (Default: 2MB)
MAX_CONTENT_LENGTH=2097152
